#!/usr/bin/env python3
import psutil, os, signal, json, threading
import argparse, sys
import time, sqlite3
from datetime import datetime, timedelta
from collections import defaultdict


VERSION = "1.9.1"


BOLD = "\033[1m"
DIM = "\033[2m"
RED = "\033[91m"
BLUE = "\033[94m"
GREEN = "\033[32m"
RESET = "\033[0m"

DIR = os.path.expanduser("~/.nusgmon")
DB_FILE = os.path.join(DIR, "db.sqlite")
os.makedirs(DIR, exist_ok=True)

VIRTUAL_IFACE_PREFIXES = ("tun", "tap", "wg", "virbr", "docker", "veth", "br-", "lo")

db_lock = threading.Lock()
conn = sqlite3.connect(DB_FILE, check_same_thread=False)
cur = conn.cursor()

cur.execute("""
CREATE TABLE IF NOT EXISTS data_usage (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp INTEGER NOT NULL,
    bytes_sent INTEGER NOT NULL,
    bytes_recv INTEGER NOT NULL,
    iface TEXT DEFAULT 'all'
)""")

cur.execute("CREATE INDEX IF NOT EXISTS idx_timestamp ON data_usage(timestamp)")

try:
    cur.execute("ALTER TABLE data_usage ADD COLUMN 'iface' TEXT")
except sqlite3.OperationalError:
    pass

conn.commit()

running = True

def handle_term(signum, frame):
    global running
    running = False

signal.signal(signal.SIGTERM, handle_term)
signal.signal(signal.SIGINT, handle_term)

def to_mb(_bytes): return _bytes / 1024 ** 2
def to_gb(_bytes): return _bytes / (1024 ** 3)

def fmt_unixtime(unixtime, format=None):
    return datetime.fromtimestamp(unixtime).strftime("%Y-%m-%d %H:%M:%S" if not format else format)

def list_interfaces():
    ifaces = psutil.net_io_counters(pernic=True)
    print(f"{BOLD}\nAvailable network interfaces:{RESET}")
    for name, c in ifaces.items():
        sent_v, sent_u = round(to_mb(c.bytes_sent)), "MB"
        recv_v, recv_u = round(to_mb(c.bytes_recv)), "MB"
        print(f" {(name):20s}  {GREEN}{(f'{sent_v:.1f} {sent_u} ↑')}  {BLUE}{(f'{recv_v:.1f} {recv_u} ↓')}{RESET}")

def current_data_json_output(total_recv, total_sent, download, upload, iface):
    """Just return the current data with pretty json"""

    output = {
            'timestamp': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
            'interface': iface,
            'total_bytes_sent': total_sent,
            'total_bytes_sent_mb': round(to_mb(total_sent)),
            'total_bytes_recv': total_recv,
            'total_bytes_recv_mb': round(to_mb(total_recv)),
            'download_kbps': download,
            'upload_kbps': upload
    }
    return json.dumps(output, indent=3)

def get_iface_counters(iface=None):
    """Return net_io_counters for a specific iface or all combined."""
    if iface:
        counters = psutil.net_io_counters(pernic=True)
        if iface not in counters:
            print(f"{RED}Interface '{iface}' not found.{RESET}\nAvailable: {', '.join(counters.keys())}")
            sys.exit(1)

        if any(iface.startswith(p) for p in VIRTUAL_IFACE_PREFIXES):
            print(f"{BOLD}Warning:{RESET} '{iface}' is a virtual interface. Traffic here is already captured by your physical interface and will be double-counted.")

        return counters[iface]
    return psutil.net_io_counters()

def log_net_usage(wait=None, dry_run=False, verbose=False, json_output=False, iface=None):
    wait = 3 if wait is None else wait

    old  = get_iface_counters(iface)
    iface_label = iface or "all"

    count = 0

    while running:
        if verbose and not json_output:
            print(f"\nWait {wait} seconds...\n")
        time.sleep(wait)

        new = get_iface_counters(iface)

        if new.bytes_recv < old.bytes_recv or new.bytes_sent < old.bytes_sent:
            # reboot or interface reset
            old = new
            continue

        # speed calculate
        download = new.bytes_recv - old.bytes_recv
        upload = new.bytes_sent - old.bytes_sent

        if json_output:
            print(current_data_json_output(new.bytes_recv, new.bytes_sent, download, upload, iface_label))
            sys.stdout.flush()
        elif verbose:
            print(f"{"-" * 6} {datetime.now().strftime("%Y-%m-%d %H:%M:%S")} {DIM}[{iface_label}]{RESET} {"-" * 6}")
            print(f"Total Megabytes Received : {round(to_mb(new.bytes_recv))} MB")
            print(f"Total Megabytes Sent     : {round(to_mb(new.bytes_sent))} MB")
            print(f"Download                 : {(download / wait) / 1024:.2f} KB/s")
            print(f"Upload                   : {(upload / wait) / 1024:.2f} KB/s")
            print("-" * 39)

        if not dry_run:
            count += 1
            with db_lock:
                cur.execute("INSERT INTO data_usage (timestamp, bytes_sent, bytes_recv, iface) VALUES (?, ?, ?, ?)",
                    (int(time.time()), new.bytes_sent, new.bytes_recv, iface_label))

                if count >= 15:
                    conn.commit()
                    count = 0

        old = new


def _to_spark(values):
    """Map a list of floats to sparkline characters."""
    if not values:
        return ""

    SPARKS = "▁▂▃▄▅▆▇█"

    lo, hi = min(values), max(values)
    span = hi - lo or 1
    return "".join(SPARKS[int((v - lo) / span * (len(SPARKS) - 1))] for v in values)


def draw_compact(data, title, total, gb_show=False):
    """
    Single-line-per-entry, no bars. Good for quick glance or narrow terminals.

    Example output:
      Today Usage
      ─────────────────────────────────
      00:00   ↑   0.12   ↓   1.43 MB
      01:00   ↑   0.00   ↓   0.00 MB
      ...
      Total: 12.34↑  45.67↓ MB
    """
    unit = "GB" if gb_show else "MB"
    print(f"\n  {title}")
    print("  " + "─" * (len(title) + 2))
    for label, val in data.items():
        up   = val["up"]
        down = val["down"]
        print(
            f"  {label:>5}   "
            f"{GREEN}↑{RESET} {up:>7.2f}   "
            f"{BLUE}↓{RESET} {down:>7.2f} {unit}"
        )
    print(f"\n  Total: {GREEN}{total['up']:.2f}↑{RESET}  {BLUE}{total['down']:.2f}↓{RESET} {unit}")


def draw_spark(data, title, total, gb_show=False):
    unit   = "GB" if gb_show else "MB"
    labels = list(data.keys())
    ups    = [v["up"]   for v in data.values()]
    downs  = [v["down"] for v in data.values()]

    STRETCH = 4  # each data point = 3 chars wide

    up_spark   = "".join(c * STRETCH for c in _to_spark(ups))
    down_spark = "".join(c * STRETCH for c in _to_spark(downs))

    n    = len(labels)
    step = max(3, n // 6)

    # each label's position is now i * STRETCH
    buf = [' '] * (n * STRETCH + 4)
    for i in range(0, n, step):
        short = labels[i].replace(":00", "")  # "09:00" -> "09"
        pos = i * STRETCH
        for j, c in enumerate(short):
            if pos + j < len(buf):
                buf[pos + j] = c
    tick_row = ''.join(buf).rstrip()

    up_peak   = labels[ups.index(max(ups))]
    down_peak = labels[downs.index(max(downs))]

    print(f"\n  {title}")
    print("  " + "─" * (len(title) + 2))
    print(f"  {GREEN}↑{RESET} {up_spark}  peak {up_peak} {max(ups):.2f} {unit}")
    print(f"  {BLUE}↓{RESET} {down_spark}  peak {down_peak} {max(downs):.2f} {unit}")
    print(f"    {tick_row}")
    print(f"\n  Total: {GREEN}{total['up']:.2f}↑{RESET}  {BLUE}{total['down']:.2f}↓{RESET} {unit}")


def draw_norm(data, title, total, gb_show=False):
    unit = "GB" if gb_show else "MB"
    WIDTH = 25

    max_up = max(v["up"] for v in data.values()) or 1
    max_down = max(v["down"] for v in data.values()) or 1

    print(f"\n  {title}")
    print("  " + "─" * (len(title) + 2))
    print(f"  peak  {GREEN}↑ {max_up:.2f}{RESET}  {BLUE}↓ {max_down:.2f}{RESET} {unit}\n")

    for label, val in data.items():
        up, down = val["up"], val["down"]

        up_fill = int((up / max_up) * WIDTH)
        down_fill = int((down / max_down) * WIDTH)

        up_bar = "█" * up_fill + "░" * (WIDTH - up_fill)
        down_bar = "█" * down_fill + "░" * (WIDTH - down_fill)

        up_pct = int((up / max_up) * 100)
        down_pct = int((down / max_down) * 100)

        print(f"  {label:>5}  {GREEN}↑{RESET} {up_bar}  {up_pct:>3}%  {up:>7.2f} {unit}")
        print(f"         {BLUE}↓{RESET} {down_bar}  {down_pct:>3}%  {down:>7.2f} {unit}")

    print(f"\n  Total: {GREEN}{total['up']:.2f}↑{RESET}  {BLUE}{total['down']:.2f}↓{RESET} {unit}")


def draw_graph(data, title, total, gb_show=False):
    max_val = max(
        max(v["up"], v["down"]) for v in data.values()
    ) if data else 0

    width = 32
    scale = max_val / width if max_val > width else 1

    print(f"\n  {title}")
    print(" ", "-" * (len(title) + 2))
    print(f"  {GREEN}█ Upload{RESET}  {BLUE}█ Download{RESET}\n")

    unit = "GB" if gb_show else "MB"

    for label, val in data.items():
        up = val["up"]
        down = val["down"]

        up_bar = "█" * int(up / scale)
        down_bar = "█" * int(down / scale)

        print(
            f"{label:>5} "
            f"{GREEN}{up_bar}{RESET}"
            f"{BLUE}{down_bar}{RESET} "
            f"{up:>6.2f}↑ {down:>6.2f}↓ {unit}"
        )

    print(f"\nTotal: {total['up']:.2f}↑ {total['down']:.2f}↓ {unit}")


def fetch_net_usage(yesterday=False, today=False, thisweek=False, json_output=False, gb_show=False, since=None, month=None, date=None, style=None, iface=None):
    now = datetime.now()

    if yesterday:
        d = now.date() - timedelta(days=1)
        t_start = int(datetime(d.year, d.month, d.day).timestamp())
        t_end   = t_start + 86400
    elif today:
        d = now.date()
        t_start = int(datetime(d.year, d.month, d.day).timestamp())
        t_end   = int(now.timestamp()) + 1
    elif thisweek:
        sow = (now - timedelta(days=now.weekday())).replace(hour=0, minute=0, second=0, microsecond=0)
        t_start = int(sow.timestamp())
        t_end   = int((sow + timedelta(days=7)).timestamp())
    elif month:
        year = now.year if month <= now.month else now.year - 1
        t_start = int(datetime(year, month, 1).timestamp())
        # first day of next month
        nm = month % 12 + 1
        ny = now.year + (1 if now.month == 12 else 0)
        t_end = int(datetime(ny, nm, 1).timestamp())
    elif since:
        try:
            since_dt = datetime.strptime(since, "%Y-%m-%d")
        except ValueError:
            print("Invalid date format. Use YYYY-MM-DD")
            return
        t_start = int(since_dt.timestamp())
        t_end   = int(now.timestamp()) + 1
    elif date:
        try:
            strp_dt = datetime.strptime(date, "%Y-%m-%d")
        except ValueError:
            print("Invalid date format. Use YYYY-MM-DD")
            return

        log_start_date = datetime.strptime(datetime.fromtimestamp(conn.execute("SELECT MIN(timestamp) FROM data_usage").fetchone()[0]).strftime("%Y-%m-%d"), "%Y-%m-%d")

        if strp_dt < log_start_date:
            print(f"No data available before {str(strp_dt).split()[0]}.")
            return
        t_start = int(strp_dt.timestamp())
        t_end = t_start + 86400
    else:
        return

    params = (iface, t_start, t_end) if iface else (t_start, t_end)

    where_clause = (
    "WHERE iface = ? AND timestamp BETWEEN ? AND ?"
    if iface else
    "WHERE timestamp BETWEEN ? AND ?"
    )

    rows = cur.execute(f"""
        SELECT timestamp, bytes_sent, bytes_recv, iface
        FROM data_usage
        {where_clause}
        ORDER BY timestamp ASC
    """, params).fetchall()

    if len(rows) < 2:
        print("Not enough data.")
        return

    buckets   = defaultdict(lambda: {"up": 0, "down": 0})
    total_up  = 0
    total_down = 0

    for i in range(1, len(rows)):
        t1, s1, r1, _ = rows[i - 1]
        t2, s2, r2, _ = rows[i]
        up   = max(0, s2 - s1)
        down = max(0, r2 - r1)
        dt   = datetime.fromtimestamp(t2)

        if yesterday or today or date:
            key = f"{dt.hour:02d}:00"
        elif thisweek:
            key = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"][dt.weekday()]
        elif month:
            key = str(dt.day)
        else:
            key = dt.strftime("%Y-%m-%d")

        buckets[key]["up"] += up
        buckets[key]["down"] += down

        total_up += up
        total_down += down

    convert = to_gb if gb_show else to_mb

    data = {
        k: {
            "up": convert(v["up"]),
            "down": convert(v["down"])
        }
        for k, v in buckets.items()
    }

    if not data:
        print("No data for this period.")
        return

    if yesterday:
        title = "Yesterday"
        data = dict(sorted(data.items()))

    elif today:
        title = "Today Usage"
        data = dict(sorted(data.items()))

    elif thisweek:
        title = "This Week Usage"
        order = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
        data = {d: data[d] for d in order if d in data}

    elif since:
        title = f"Since {since}"
        data = dict(sorted(data.items()))  # already YYYY-MM-DD so lexical sort = chronological

    elif date:
        title= f"{str(strp_dt).split()[0]}"
        data = dict(sorted(data.items()))

    else:
        title = f"Month {month} Usage"
        data = dict(sorted(data.items(), key=lambda x: int(x[0])))

    if iface:
        title += f" [{iface}]"

    total = {
        "up": round(convert(total_up), 2),
        "down": round(convert(total_down), 2)
    }

    GRAPH_STYLES = {
        "bar":     draw_graph,
        "compact": draw_compact,
        "spark":   draw_spark,
        "norm": draw_norm
    }

    if json_output:
        data["total"] = [total]
        pretty = json.dumps(data, indent=3)
        print(pretty)
    else:
        renderer = GRAPH_STYLES.get(style, draw_graph)
        renderer(data, title, total, gb_show=gb_show)


def db_stats(json_output=False):
    count  = conn.execute("SELECT COUNT(*) FROM data_usage").fetchone()[0]
    oldest = conn.execute("SELECT MIN(timestamp) FROM data_usage").fetchone()[0]
    newest = conn.execute("SELECT MAX(timestamp) FROM data_usage").fetchone()[0]
    most_traffic = conn.execute("""
    SELECT (timestamp / 86400) * 86400 AS day,
        SUM(bytes_sent + bytes_recv) AS total
    FROM data_usage
    GROUP BY day
    ORDER BY total DESC LIMIT 1
    """).fetchone()[0]
    least_traffic = conn.execute("""
        SELECT (timestamp / 86400) * 86400 AS day,
            SUM(bytes_sent + bytes_recv) AS total
        FROM data_usage
        GROUP BY day
        ORDER BY total ASC LIMIT 1
    """).fetchone()[0]
    size   = os.path.getsize(DB_FILE) / 1024

    fmt_oldest = fmt_unixtime(oldest)
    fmt_newest = fmt_unixtime(newest)
    fmt_mt = fmt_unixtime(most_traffic).split()[0]
    fmt_lt = fmt_unixtime(least_traffic).split()[0]

    if json_output:
        data = {
            'records': count,
            'size_in_kb': size,
            'oldest_record': fmt_oldest,
            'newest_record': fmt_newest,
            'most_traffic': fmt_mt,
            'least_traffic': fmt_lt
        }
        print(json.dumps(data, indent=3))
    else: 
        print(f"\n  {BOLD}Database info{RESET}\n")
        print(f"  {'Records':<18} {count:,}")
        print(f"  {'Size':<18} {size:.1f} KB  ({DB_FILE})")
        if oldest:
            print(f"  {'Oldest record':<18} {fmt_oldest}")
            print(f"  {'Newest record':<18} {fmt_newest}")
        print(f"  {'Most Traffic':<18} {fmt_mt}")
        print(f"  {'Least Traffic':<18} {fmt_lt}")


def db_prune(days):
    cutoff = int((datetime.now() - timedelta(days=days)).timestamp())
    format_cutoff = datetime.fromtimestamp(cutoff).strftime("%Y %d %b")
    confirm = input(f"Records before {format_cutoff} will be pruned. Continue? [y/N] ")
    if confirm.strip().lower() != "y":
        print("abort.")
        return
    cur = conn.cursor()
    cur.execute("DELETE FROM data_usage WHERE timestamp < ?", (cutoff,))
    deleted = cur.rowcount
    conn.commit()
    conn.execute("VACUUM")
    print(f"{BOLD}{GREEN}Pruned {deleted:,} records older than {days} days.{RESET}")


parser = argparse.ArgumentParser(
    prog="nusgmon",
    description=(
        f"{BOLD}nusgmon{RESET} — Network usage monitoring tool"
        "\nRecord live bandwidth usage."
        "\nAnalyze your data usage.\n"
        f'\n{BOLD}v{VERSION}{RESET}'
    ),
    formatter_class=argparse.RawTextHelpFormatter,
    epilog=(
            "Examples:\n"
            "  nusgmon record -w 5 -v                            Record with 5s interval, verbose (Running as a service recommended)\n"
            "  nusgmon --today                                   Show today's usage\n"
            "  nusgmon --thisweek --json                         This week as JSON\n"
            "  nusgmon --since 2026-04-14 -g                     Since date, in GB\n"
            "  nusgmon --today --style compact                   Today usage in compact graph style\n"
            "  nusgmon db --stats                                Database info\n"
            "  nusgmon record --iface tun0                       Record only the tun0 (VPN) interface data usage\n"
            "  nusgmon --iface wlan0 --style compact --thisweek  Show current week's usage in compact style of only wlan0 (WiFi) interface"
    ))

sub = parser.add_subparsers(dest="command")
record_parser = sub.add_parser("record", help="Start recording network usage")

record_parser.add_argument("-w", "--wait", type=float, help="record after certain seconds (default: 3)")
record_parser.add_argument("-d", "--dry-run", action="store_true", help="prevent logging to database")
record_parser.add_argument("-v", "--verbose", action="store_true", help="enable verbose output")
record_parser.add_argument("--json", action="store_true", help="output data JSON format")
record_parser.add_argument("--iface", type=str, nargs="+", default=None, help="interface(s) to record (default all in bundle)")

db_parser = sub.add_parser("db", help="Database maintenance")
db_parser.add_argument("--stats", action="store_true", help="show database stats")
db_parser.add_argument("--json", action="store_true", help="output data JSON format")
db_parser.add_argument("--prune", type=int, metavar="DAYS", help="delete data older than N days")

parser.add_argument("--yesterday", action="store_true", help="show yesterday's usage")
parser.add_argument("--today", action="store_true", help="show today's usage")
parser.add_argument("--thisweek", action="store_true", help="show this week's usage")
parser.add_argument("--date", type=str, metavar="YYYY-MM-DD", help="show given date's usage")
parser.add_argument("--month", nargs="?", const=datetime.now().month, type=int, choices=range(1, 13), metavar="N", help="show any month's usage 1-12 (default: current month)")
parser.add_argument("--json", action="store_true", help="output data JSON format")
parser.add_argument("-g", "--gigabyte", action="store_true", help="show data usage in giga byte (GB)")
parser.add_argument("--since", type=str, help="show data usage after a certain time")
parser.add_argument("--style", choices=["bar", "compact", "spark", "norm"], default="bar", help="graph display style (default: bar)")
parser.add_argument("-V", "--version", action="version", version=f'v{VERSION}')
parser.add_argument("--iface", type=str, help="View a specific interface data usage only (default all in bundle)")

sub.add_parser("interfaces", help="List available network interfaces")

args = parser.parse_args()


if args.command in ("record", "db", "interfaces"):
    try:
        if args.command == "record":
            ifaces = args.iface or [None] # none means all combined
            if len(ifaces) == 1:
                log_net_usage(args.wait, args.dry_run, args.verbose, args.json, ifaces[0])
            else:
                threads = []
                for iface in ifaces:
                    t = threading.Thread(target=log_net_usage, args=(args.wait, args.dry_run, args.verbose, False, iface), daemon=True)
                    t.start()
                    threads.append(t)
                for t in threads:
                    t.join()
        elif args.command == "interfaces":
            list_interfaces()

        else:
            if args.prune:
                db_prune(args.prune)
            else:
                db_stats(json_output=args.json)
    finally:
        conn.commit()
        conn.close()
else:
    fetch_kwargs = dict(json_output=args.json, gb_show=args.gigabyte, style=args.style, iface=args.iface)
    fetch_net_usage(
        yesterday = args.yesterday or False,
        today     = args.today     or not any([args.yesterday, args.thisweek, args.month, args.since, args.date]),
        thisweek  = args.thisweek  or False,
        month     = args.month     or False,
        since     = args.since     or False,
        date      = args.date      or False,
        **fetch_kwargs
    )

print()


