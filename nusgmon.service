[Unit]
Description=System network usage monitoring tool
Documentation=
Requires=
After=

[Service]
ExecStart=
# Example:
# ExecStart=/usr/bin/env /opt/myapp/app.py --flag
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID

# --- Process behavior ---
Type=simple
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=15

[Install]
WantedBy=default.target
